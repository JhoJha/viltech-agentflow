{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viltech.dev/schemas/queue.schema.json",
  "title": "AgentFlow AUTONOMY-001 queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue_id", "items", "budgets"],
  "properties": {
    "queue_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "program"],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "program": {"type": "string", "minLength": 1}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "model_calls", "retries", "fallbacks", "corrections"],
      "properties": {
        "wall_clock_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "model_calls": {"type": "integer", "minimum": 1, "maximum": 128},
        "retries": {"type": "integer", "minimum": 0, "maximum": 128},
        "fallbacks": {"type": "integer", "minimum": 0, "maximum": 128},
        "corrections": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fallback_profiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "architect": {"type": "string", "minLength": 1},
            "worker": {"type": "string", "minLength": 1},
            "reviewer": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
