{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["task_id", "repo", "risk", "objective", "allowed_paths", "validators"],
  "properties": {
    "task_id": {"type": "string"},
    "repo": {"type": "string"},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "objective": {"type": "string"},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "validators": {"type": "array", "minItems": 1},
    "model_inactivity_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional opt-in model output-inactivity limit in seconds. When absent, inactivity detection is disabled. When present, must be a positive integer strictly less than the effective model_timeout_seconds; a supervised model process that produces no stdout/stderr output for this long while its leader is still alive is terminated and reported as STALL_DETECTED."
    },
    "max_corrections": {"type": "integer", "minimum": 0, "maximum": 2},
    "isolation": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "baseline_commit": {"type": "string"}
      },
      "required": ["enabled", "baseline_commit"],
      "additionalProperties": false
    }
  }
}
